# Copy to .env and fill in. .env is gitignored and never committed.
GMAIL_ADDRESS=you@gmail.com
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=
PHONE=
YOUR_NAME=Your Full Name
# Google Drive link set to "Anyone with the link can view"
RESUME_LINK=

DAILY_LIMIT=30
MIN_GAP_SECONDS=90
MAX_GAP_SECONDS=300
FOLLOWUP_AFTER_DAYS=5
# Only email the first HR at each company (282 companies have 2+ contacts)
ONE_PER_COMPANY=true
# Extra addresses never to email. Replies and bounces are skipped automatically.
SKIP_EMAILS=
# Also email catch-all / risky addresses from the verification results
ALLOW_RISKY=false
# Stop sending when over 8% of emails bounce. Turning this off risks the Gmail account.
PAUSE_ON_BOUNCES=true
